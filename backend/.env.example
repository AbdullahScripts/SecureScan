SECRET_KEY= whatShouldBeASecretKey
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./malware_detection.db
# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000
# Optional: VirusTotal API v3 key (hash lookup only — never uploads files)
# Get a key at https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY= 
VIRUSTOTAL_TIMEOUT_SECONDS=30
YARA_RULES_PATH=app/yara_rules/demo_rules.yar
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads
# MalConv AI Scanner
MALCONV_MODEL_REPO=cycloevan/malconv
MALCONV_WEIGHTS_FILE=models/malconv_model.h5
MALCONV_MAX_BYTES=2000000
ENABLE_AI_SCANNER=true
# Optional: Groq API key for chatbot (uses httpx, no SDK)
# Get a key at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=30
# Optional: GNews API key for news
GNEWS_API_KEY= 
GNEWS_TIMEOUT_SECONDS=10
